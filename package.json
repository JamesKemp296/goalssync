{
  "name": "goalssync.com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "supabase": "npx supabase@2.95.3",
    "db:push": "npx supabase@2.95.3 db push",
    "db:migration-list": "npx supabase@2.95.3 migration list",
    "db:clear-lists": "npx supabase@2.95.3 db query -f supabase/scripts/clear_lists_for_migration_sync.sql --linked",
    "db:reset-migrations": "npx supabase@2.95.3 db query -f supabase/scripts/reset_migration_history.sql --linked",
    "deploy:function:invite-friend": "npx supabase functions deploy invite-friend",
    "deploy:function:send-test-push": "npx supabase functions deploy send-test-push",
    "deploy:function:weekly-recap-push": "npx supabase functions deploy weekly-recap-push --no-verify-jwt",
    "deploy:function:daily-reminder-push": "npx supabase functions deploy daily-reminder-push --no-verify-jwt",
    "invoke:function:weekly-recap-push": "node scripts/invoke-weekly-recap-push.mjs",
    "invoke:function:daily-reminder-push": "node scripts/invoke-daily-reminder-push.mjs",
    "generate:vapid-keys": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/lab": "^9.0.0-beta.2",
    "@mui/material": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.2",
    "@supabase/supabase-js": "^2.78.0",
    "dayjs": "^1.11.20",
    "notistack": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "supabase": "^2.95.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.2.0",
    "web-push": "^3.6.7"
  }
}
